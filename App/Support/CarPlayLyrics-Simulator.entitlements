<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator only. Apple's CarPlay rules don't allow lyrics on the CarPlay screen, so this
	     entitlement can't be granted for a real device; device builds use CarPlayLyrics.entitlements. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
